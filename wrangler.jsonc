{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macrowire",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "macrowire.co.uk", "custom_domain": true }
  ],
  "assets": {
    "directory": "public_site"
  }
}
