# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ThetaData API key, used by the data pipeline (theta.py).
THETADATA_API_KEY=

# Local dev token for the read-only API (api/auth.py) and the web login.
MACRO_WIRE_DEV_TOKEN=

# Anthropic API key, used by the tutor panel (web/tutor/).
ANTHROPIC_API_KEY=

# Optional overrides (web/settings.py); the defaults suit local development.
# MW_API_BASE=http://127.0.0.1:8000
# MW_USERS_DB=web/var/users.sqlite
